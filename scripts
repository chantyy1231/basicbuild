door.Transparency = 0
door.CanCollide = true

openEvent.OnServerEvent:Connect(function(player, writtenPassword)
	
	door.Transparency = 1
	door.CanCollide = false	
	
	task.wait(5)
	
	door.Transparency = 0
	door.CanCollide = true
	
end)

